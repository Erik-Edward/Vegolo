# Kopiera till .env.local och fyll i vid behov. .env.local committas aldrig.

# Tvingar fram en momssats oavsett datum. Används för att förhandsgranska
# hur sajten ser ut efter momshöjningen 2028-01-01. Lämna tom i drift.
# NEXT_PUBLIC_VAT_RATE_OVERRIDE=0.12

# Visar ogranskat regulatoriskt innehåll även i en produktionsbyggd
# förhandsvisning. Får aldrig sättas på den publika sajten.
# NEXT_PUBLIC_SHOW_DRAFT_CONTENT=1
